# Variables lues par docker-compose (copier en ? .env ? ? la racine : ce fichier-l? n'est jamais commit?).
# Les secrets du backend sont dans backend/.env (voir backend/.env.example).

# Mot de passe de la base PostgreSQL (obligatoire).
POSTGRES_PASSWORD=

# --- Sauvegardes (service ? backup ?) ---
# Jours de conservation des sauvegardes sur le serveur.
BACKUP_KEEP_DAYS=14
# Facultatif mais recommand? : adresse d'un service de surveillance ? heartbeat ? (healthchecks.io, Uptime Kuma?).
# Appel?e apr?s chaque sauvegarde r?ussie, et avec ? /fail ? ajout? apr?s un ?chec : le service alerte si une sauvegarde manque.
BACKUP_PING_URL=

# --- Copie hors du serveur (profil ? offsite ?, facultatif) : docker compose --profile offsite up -d offsite ---
# Destination rclone, par exemple ? offsite:mon-bucket/keuria ?.
OFFSITE_REMOTE=
# Configuration du remote ? offsite ? de rclone (exemple pour un stockage compatible S3) :
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.org
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
