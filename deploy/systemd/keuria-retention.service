# Remplace le service « retention » du docker-compose (qui bouclait avec un sleep 86400) :
# ici c'est le minuteur systemd qui donne le rythme (keuria-retention.timer).
# Conservation limitée des comptes familiaux inactifs (avertissement, désactivation, suppression)
# et chiffres mensuels figés. Simulation sans risque :
#   sudo -u keuria /opt/keuria/backend/.venv/bin/python /opt/keuria/backend/manage.py apply_retention --dry-run

[Unit]
Description=kEur IA - conservation limitee des donnees (apply_retention)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=keuria
Group=keuria
WorkingDirectory=/opt/keuria/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/keuria/backend/.venv/bin/python manage.py apply_retention
SyslogIdentifier=keuria-retention

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
