SECRET_KEY=change-me-to-a-random-secret-in-every-environment
# Production : False (valeur par défaut). En local, mettre True.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for local development (explicit decision, 2026-09-16): PostgreSQL
# credentials were not available locally, and the choice was made to defer
# the Postgres switch to when a deployment target is decided. The ORM code
# must stay portable (no SQLite-only fields/queries) so that switching
# DATABASE_URL to a postgres:// value later is the only change needed.
DATABASE_URL=sqlite:///db.sqlite3

# Comma-separated list of origins allowed to call the API with credentials.
# Must match wherever `npm run dev`/`npm run start` actually serves the
# frontend from (see frontend/package.json).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Django n'est joignable qu'à travers le proxy Next.js : l'IP réelle du client
# est la dernière entrée de X-Forwarded-For. Mettre 0 si Django est exposé
# directement (sans proxy).
NUM_PROXIES=1
# Débit maximal par IP sur /api/auth/* (connexion, inscription, mot de passe oublié).
AUTH_THROTTLE_RATE=60/min

# Palou (assistant IA des apprenants) : clé de l'API Anthropic. Sans clé,
# Palou répond « indisponible » (aucune réponse simulée).
# Seul le texte de la question est transmis, jamais l'identité de l'enfant.
ANTHROPIC_API_KEY=
PALOU_MODEL=claude-haiku-4-5-20251001
PALOU_THROTTLE_RATE=20/min
# Débit maximal par utilisateur sur /api/progress/record-activity (erreurs et quiz du parcours).
ACTIVITY_THROTTLE_RATE=60/min
# Les logos d'école sont servis par Django sous /media/ tant qu'aucun serveur web ne s'en charge (False = désactiver).
SERVE_MEDIA=True

# Fuseau horaire des « jours » (série de connexion, temps d'écran, défi du jour). Défaut : Africa/Dakar.
TIME_ZONE=Africa/Dakar

# Cache partagé OBLIGATOIRE en production avec plusieurs workers (verrouillage des connexions, limitation de
# débit, déverrouillages parentaux). Exemple : redis://redis:6379/1
REDIS_URL=
# Un seul processus sans Redis (ne pas utiliser en production multi-workers) : ALLOW_LOCAL_CACHE=True
# Administration Django : fermée hors développement. ADMIN_ENABLED=True pour l'ouvrir, avec une adresse non standard.
ADMIN_ENABLED=False
# Conservation des comptes familiaux inactifs (jours) : avertissement après 730, désactivation 30 jours après, suppression 30 jours de plus.
# À planifier chaque jour : python manage.py apply_retention   (essai sans risque : --dry-run)
RETENTION_INACTIVE_DAYS=730
RETENTION_NOTICE_DAYS=30
RETENTION_GRACE_DAYS=30
ADMIN_URL=admin/

# Envoi des codes de vérification / réinitialisation (SMTP). Sans ces valeurs (DEBUG=True), les e-mails
# s'affichent dans la console. Utiliser un mot de passe d'application dédié et jamais réutilisé.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Fournisseur SMTP. Par défaut Gmail (smtp.gmail.com:587, STARTTLS) : ne renseigner ces lignes que pour
# un autre serveur. Pour un port 465 (chiffré dès la connexion) : EMAIL_PORT=465 et EMAIL_USE_SSL=True.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
# Expéditeur affiché. Par défaut le compte authentifié ; certains fournisseurs n'acceptent que celui-là.
DEFAULT_FROM_EMAIL=

# HTTPS (production) : redirection et HSTS. N'activer les sous-domaines/preload qu'une fois HTTPS validé partout.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Alertes push des parents (Web Push). Générer les clés : python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUBJECT=mailto:contact@example.com

# Sessions : elles se terminent à la fermeture du navigateur.
# Déconnexion après N minutes sans action de la personne. 0 = pas de limite.
# Comptes d'administration (plateforme, direction d'école) :
ADMIN_IDLE_TIMEOUT_MINUTES=30
# Parents, enseignants, élèves :
USER_IDLE_TIMEOUT_MINUTES=120
# ── Exploitation ───────────────────────────────────────────────────────────────────────────────────────────────
# Journaux : niveau (DEBUG, INFO, WARNING, ERROR) et format. LOG_JSON=True (défaut hors DEBUG) = une ligne JSON par événement,
# lisible par Loki/ELK/CloudWatch ; False = texte lisible en développement.
LOG_LEVEL=INFO
LOG_JSON=False
# Suivi des erreurs (Sentry ou compatible) : facultatif. Aucune donnée personnelle n'est envoyée (send_default_pii=False).
# Installer d'abord le client : pip install sentry-sdk
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Hôtes internes toujours acceptés en plus de ALLOWED_HOSTS : sonde de santé du conteneur et relais Next.js (nom du service Docker).
INTERNAL_HOSTS=127.0.0.1,localhost,backend
# Limites par défaut de toutes les routes (large : une classe entière peut partager une adresse IP).
ANON_THROTTLE_RATE=600/min
USER_THROTTLE_RATE=1200/min
# Processus gunicorn (défaut : 2 x cœurs + 1, plafonné à 4) et fils d'exécution par processus.
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
# Mot de passe des comptes de DÉMONSTRATION (commande seed_demo_school, développement uniquement). Vide = tiré au hasard et affiché.
DEMO_PASSWORD=
# Docker Compose : mot de passe PostgreSQL (à mettre dans un fichier .env À LA RACINE, pas ici) et durée de conservation des sauvegardes.
# POSTGRES_PASSWORD=
# BACKUP_KEEP_DAYS=14
# Plafond de messages Palou par enfant et par jour (coût du service). 0 = pas de plafond.
PALOU_DAILY_MESSAGES=60
# Les propositions des défis et énigmes du jour sont mélangées par le serveur (la bonne réponse change de place). False = ordre de la banque.
SHUFFLE_ANSWER_OPTIONS=True
# PRODUCTION : la base doit être PostgreSQL (DATABASE_URL=postgres://...). Sans elle, Django retombe sur SQLite et `check --deploy` échoue
# (keuria.E005). Un essai isolé seulement : ALLOW_SQLITE=True.
# Alertes d'incident (erreurs 500). Aucun destinataire par défaut : sans ces valeurs, rien n'est envoyé.
# Le texte des exceptions n'est jamais transmis (il peut contenir des données d'enfants) : on envoie le type et l'identifiant de requête.
# Les adresses de webhook doivent être en HTTPS.
ADMINS_EMAILS=
WHATSAPP_ALERT_WEBHOOK_URL=
WHATSAPP_API_TOKEN=
