# Variables du frontend Next.js. Copier en .env.local (développement) ou les passer à l'image Docker.

# Adresse du serveur Django, jointe par le serveur Next.js pour relayer /api/* et /media/*.
# Lue AU BUILD (réécritures) : la fixer avant `npm run build` (ARG DJANGO_API_URL dans le Dockerfile).
DJANGO_API_URL=http://127.0.0.1:8000

# Adresses e-mail (séparées par des virgules) autorisées à ouvrir l'espace d'administration de la plateforme côté interface.
# Le droit réel reste contrôlé par le serveur Django (rôle du compte).
KEUR_ADMIN_EMAILS=

# true : seules les leçons du parcours 7-9 relues par une enseignante ou un enseignant sont proposées aux élèves.
# À activer en production quand les relectures sont faites (voir frontend/content/parcours79 : champ « review »).
NEXT_PUBLIC_REQUIRE_REVIEWED_CONTENT=false
