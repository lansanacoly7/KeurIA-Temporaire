{
  "name": "keur-ia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev -p 3000",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test node --test \"tests/*.test.mjs\"",
    "test:coverage": "node scripts/ensure-coverage-dir.mjs && cross-env NODE_ENV=test node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout \"tests/*.test.mjs\"",
    "test:parcours79": "cross-env NODE_ENV=test node --test tests/parcours79-logic.test.mjs tests/parcours79-player.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@rive-app/react-canvas": "^4.34.3",
    "blockly": "^12.5.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^7.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "kEur IA"
}
